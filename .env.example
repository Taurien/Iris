# Copiar a .env (gitignored) y completar con valores reales. chmod 600 .env

TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=

# auto | claude-code | opencode | antigravity
# "auto" (recomendado): rota sola — Google (antigravity) por defecto, Claude
# para lo relacionado a código, opencode como respaldo si fallan los otros dos.
IRIS_BRAIN=auto

# Nombre del modelo a pasarle al backend elegido (opcional, cada backend tiene un default razonable)
IRIS_MODEL=

# Token para la API HTTP local (POST /message) — generar una vez con:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
IRIS_API_KEY=

# API key de build.nvidia.com, para el proveedor "nvidia" custom de opencode
# (opencode.json, agent.iris) — generarla en https://build.nvidia.com (botón
# "Get API Key" en la página de cualquier modelo).
NVIDIA_API_KEY=
